# Esempio di variabili da impostare. NON mettere qui le password vere e
# NON committare mai un file .env reale in git: in Portainer vanno inserite
# nella sezione "Environment variables" dello stack (vedi README.md).

DB_ROOT_PASSWORD=cambia-questa-password
WP_DB_NAME=esempio_db
WP_DB_USER=esempio_user
WP_DB_PASSWORD=cambia-anche-questa
